APP_NAME=candidate-api
APP_PORT=8080
APP_ENV=development

# Adapters are optional. Wire them in main only when enabled.
# DB defaults to on; Redis, MinIO, and JWT default to off.
DB_ENABLED=true
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=candidate-api_db
DB_SSL_MODE=disable

# Redis backs distributed API and authentication rate limits.
# Not required when APP_ENV=development is set explicitly; that value skips every limit.
# A blank APP_ENV still enforces the limits and requires Redis.
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Private RustFS bucket (S3 API). The bkgo adapter reads these MINIO_* settings.
# Keep MINIO_ENABLED=false to run without avatar upload. The bucket is not public.
MINIO_ENABLED=false
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=candidate-api-files
MINIO_USE_SSL=false

# Set JWT_ENABLED=true and provide a secret to protect API routes.
# If JWT_ENABLED is omitted, a non-empty JWT_SECRET enables authentication.
JWT_ENABLED=false
JWT_SECRET=

# Production: comma-separated ingress proxy IPs/CIDRs; ingress must set or append X-Forwarded-For.
TRUSTED_PROXIES=

# Comma-separated browser origins (scheme://host[:port], no "*") for CORS and WebSocket.
# Empty uses http://localhost:3000,http://localhost:5173; a value replaces that list.
ALLOWED_ORIGINS=

# Operator-only candidate tenant setup. Supply test-only values in ignored .env or
# the process environment; 8–72 bytes each. Never commit real credentials.
CANDIDATE_1_ADMIN_PASSWORD=
CANDIDATE_1_EMPLOYEE_PASSWORD=
CANDIDATE_2_ADMIN_PASSWORD=
CANDIDATE_2_EMPLOYEE_PASSWORD=
CANDIDATE_3_ADMIN_PASSWORD=
CANDIDATE_3_EMPLOYEE_PASSWORD=
CANDIDATE_4_ADMIN_PASSWORD=
CANDIDATE_4_EMPLOYEE_PASSWORD=
CANDIDATE_5_ADMIN_PASSWORD=
CANDIDATE_5_EMPLOYEE_PASSWORD=
CANDIDATE_6_ADMIN_PASSWORD=
CANDIDATE_6_EMPLOYEE_PASSWORD=
CANDIDATE_7_ADMIN_PASSWORD=
CANDIDATE_7_EMPLOYEE_PASSWORD=
CANDIDATE_8_ADMIN_PASSWORD=
CANDIDATE_8_EMPLOYEE_PASSWORD=
CANDIDATE_9_ADMIN_PASSWORD=
CANDIDATE_9_EMPLOYEE_PASSWORD=
CANDIDATE_10_ADMIN_PASSWORD=
CANDIDATE_10_EMPLOYEE_PASSWORD=
