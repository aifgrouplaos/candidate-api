APP_NAME=candidate-api
APP_PORT=8080
APP_ENV=development

# Adapters are optional. Wire them in main only when enabled.
# DB defaults to on; Redis, MinIO, and JWT default to off.
DB_ENABLED=true
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=candidate-api_db
DB_SSL_MODE=disable

REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

MINIO_ENABLED=false
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=candidate-api-files
MINIO_USE_SSL=false

# Set JWT_ENABLED=true and provide a secret to protect API routes.
# If JWT_ENABLED is omitted, a non-empty JWT_SECRET enables authentication.
JWT_ENABLED=false
JWT_SECRET=
